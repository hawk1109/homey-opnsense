        {
          "id": "show_events",
          "type": "checkbox",
          "title": {
            "en": "Show recent events",
            "nl": "Toon recente gebeurtenissen"
          },
          "value": true
        }
      ],
      "devices": {
        "type": "app",
        "singular": true,
        "filter": {
          "driver_id": "firewall"
        }
      },
      "api": {
        "getData": {
          "method": "GET",
          "path": "/"
        }
      },
      "id": "health"
    }
  },
