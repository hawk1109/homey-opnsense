      "capabilitiesOptions": {
        "alarm_generic": {
          "title": {
            "en": "Problem",
            "nl": "Probleem"
          },
          "insightsTitleTrue": {
            "en": "Problem",
            "nl": "Probleem"
          },
          "insightsTitleFalse": {
            "en": "Healthy",
            "nl": "Gezond"
          }
        },
        "measure_temperature": {
          "title": {
            "en": "Temperature",
            "nl": "Temperatuur"
